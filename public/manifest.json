{
  "manifest_version": 3,
  "name": "FFB Lens — Video Analyzer",
  "short_name": "FFB Lens",
  "version": "0.7.6",
  "description": "Scan Facebook Reels and TikTok profile videos locally from the tab you choose.",
  "minimum_chrome_version": "114",
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Open FFB Lens" },
  "side_panel": { "default_path": "index.html" },
  "background": { "service_worker": "service-worker.js" },
  "permissions": ["sidePanel", "activeTab", "scripting"],
  "optional_host_permissions": ["https://*.facebook.com/*", "https://*.tiktok.com/*"]
}
